 @using FoodOrder.Models.ViewModels
@model CartItemViewModel

<!-- Breadcrumb Section Begin -->
<section class="hero hero-normal">
    <div class="container">
        <div class="row">
            <div class="col-lg-3">
                <div class="hero__categories">
                    <div class="hero__categories__all">
                        <i class="fa fa-bars"></i>
                        <span>Danh mục</span>
                    </div>
                    <ul>
                        <vc:categories></vc:categories>
                    </ul>
                </div>
            </div>
            <div class="col-lg-9">
                <div class="hero__search">
                    <div class="hero__search__form">
                        @Html.Partial("_Search")
                    </div>
                    <div class="hero__search__phone">
                        <div class="hero__search__phone__icon">
                            <i class="fa fa-phone"></i>
                        </div>
                        <div class="hero__search__phone__text">
                            <h5>+65 11.188.888</h5>
                            <span>support 24/7 time</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Hero Section End -->
<!-- Breadcrumb Section Begin -->
<section class="breadcrumb-section set-bg" data-setbg="/Frontend/img/breadcrumb.jpg">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 text-center">
                <div class="breadcrumb__text">
                    @* <h2>@Model.Foods.Title</h2> *@
                    <div class="breadcrumb__option">
                        <a asp-action="Index" asp-controller="Home">Trang chủ</a>
                        <a asp-action="Index" asp-controller="Cart" >Giỏ hàng</a>
                        @* <span>@Model.Foods.Title</span> *@
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Breadcrumb Section End -->
<!-- Shoping Cart Section Begin -->
<section class="shoping-cart spad">
    <div class="container">

        <div class="row">
            <div class="col-lg-12">
                <div class="shoping__cart__table">
                    <table>
                          @if(Model.CartItems.Count() > 0)
					       {
                        <thead>
                            <tr>
                                <th class="shoping__product">Sản phẩm</th>
                                <th>Gía</th>
                                <th>Số lượng</th>
                                <th>Thành tiền</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                          
                                @foreach (var item in Model.CartItems)
                                {
                                            <form asp-action="UpdateCart" asp-controller="Cart"  asp-route-Id="@item.FoodId">

                                    <tr>
                                        <td class="shoping__cart__item">
                                                <img src="~/image/food/@item.Image" style="height: 200px; width:50%;" alt="">
                                            <h5>@item.FoodName</h5>
                                        </td>
                                        <td class="shoping__cart__price">
                                                @item.Price.ToString("#,##0 VND")
                                        </td>
                                        <td class="shoping__cart__quantity">
                                            <div class="quantity">
                                                <div class="pro-qty">
                                                    <a asp-action="Decrease" asp-controller="Cart" asp-route-Id="@item.FoodId"><span class="dec qtybtn">-</span></a>
                                                    <input type="text" Id="quantity" name="quantity" value="@item.Quantity">
                                                    <a asp-action="Increase" asp-controller="Cart" asp-route-Id="@item.FoodId"><span class="inc qtybtn">+</span></a>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="shoping__cart__total">
                                                @Model.CartItems.Where(x => x.FoodId == item.FoodId).Sum(x => x.Quantity * x.Price).ToString("#,##0 VND")
                                        </td>
                                        <td class="shoping__cart__item__close">
                                            <a asp-action="Remove" asp-controller="Cart" asp-route-Id="@item.FoodId" class="btn btn-danger"><span class="icon_close"></span></a>
                                        </td>
                                            
                                        
                                    </tr>
                                    <tr class="text-center border-none">
                                        <td colspan="8" class="shoping__cart__item__close border-none">
                                            <button style="border:none;" type="submit" class="primary-btn  border-none">
                                                    <span class="icon_loading"></span> cập nhật
                                                </button>
                                            </td>
                                    </tr>
                                    </form>


                                    
                                
                                }
                               
                                </tbody>
                                
                            } else
                            {
                            <h4>Không món ăn nào!</h4>
                            }
                    </table>
                </div>
            </div>
        </div>

        <div class="row">
           
            <div class="col-lg-6">
                <div class="shoping__continue">
                    <div class="shoping__discount">
                       
                            <h5>Phiếu giảm giá</h5>
                            <form >
                                <input type="text" class=" coupon-value" placeholder="nhập phiếu giảm giá">
                                <button type="submit" class="site-btn btn-apply-coupon">Ap dụng</button>
                                <p><span class="text text-success" value="apply">@Model.CouponCode</span></p>
                            </form>
                    </div>
                </div>
                <div class="row">
                    <div class="col-9">
                        <div class="form-group">
                            <label>Chọn Tỉnh thành phố</label>
                            <select class="form-control css_select" name="tinh" id="tinh" title="chọn Tỉnh thành">
                                <option value="0">Tỉnh/Thành phố</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label>Chọn Quận huyện</label>
                            <select class="form-control css_select" name="quan" id="quan" title="chọn quận huyện">
                                <option value="0">Quận huyện</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label>Chọn Phường xã</label>
                            <select class="form-control css_select" name="phuong" id="phuong" title="chọn phường xã">
                                <option value="0">Phường xã</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <button type="button" class="btn btn-primary btn-add-shipping" >
                                Tính phí ship
                            </button>
                        </div>
                    </div>
                </div>
               
            </div>
          <div class="col-lg-6">
    <div class="shoping__checkout">
        <h5>Tổng:</h5>
        <ul>
            <li>
                Tổng tiền (đã bao gồm phí vận chuyển)
                <span>@((Model.CartItems.Sum(x => x.Quantity * x.Price) + (Model.ShippingCost > 0 ? Model.ShippingCost : 15000)).ToString("#,##0 VND"))</span>
            </li>
            <li>Tổng tiền <span>@Model.GrandTotal.ToString("#,##0 VND")</span></li>
            <li>
                Phí vận chuyển
                <span>@(Model.ShippingCost > 0 ? Model.ShippingCost.ToString("#,##0 VND") : "15,000 VND")</span>
            </li>
        </ul>
                    @if (Model.CartItems.Count > 0)
                    {
                        <a asp-action="Index" asp-controller="Checkout" class="primary-btn">Đặt hàng</a>
                    }
                    else
                    {
                        <a class="primary-btn disabled" style="pointer-events:none;">Đặt hàng</a>
                    }

    </div>
</div>


        </div>
        
    </div>
</section>

@section Scripts {
    
    <script>
        $(".btn-apply-coupon").click(function (event) {
            event.preventDefault(); // Prevent form submission

            var coupon_value = $(".coupon-value").val();
            $.ajax({
                type: "POST",
                url: "@Url.Action("GetCoupon", "Cart")",
                data: { coupon_value: coupon_value },
                success: function (result) {
                    if (result.success) {
                        alert("Áp phiếu giảm giá thành công");
                        location.reload();
                    } else {
                        alert(result.message);
                    }
                },
                error: function () {
                    alert("Đã xảy ra lỗi khi áp dụng phiếu giảm giá.");
                }
            });
        });
    </script>
    <script>
        $(".btn-add-shipping").on("click", function () {
            var tinh = $("#tinh").find("option:selected").text();
            var quan = $("#quan").find("option:selected").text();
            var phuong = $("#phuong").find("option:selected").text();

            // var price = $("#price-shipping").val();
            if (tinh == "" || quan == "" || phuong == "") {
                alert("Làm ơn ko bỏ trống");
            } else {
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("GetShipping", "Cart")",
                    data: { tinh: tinh, quan: quan, phuong: phuong },
                    success: function (result) {
                        if (result.success) {
                             alert("Thêm vận chuyển thành công");
                            location.reload();

                        } else if (result.duplicate) {
                            alert("Có lỗi");

                        }


                    }



                });

            }
        });


    </script>
    <script>
        $(document).ready(function () {
            const apiBase = 'https://esgoo.net/api-tinhthanh';

            // Hàm tải dữ liệu JSON
            function loadData(url, successCallback, errorCallback) {
                $.getJSON(url, function (response) {
                    if (response.error === 0) {
                        successCallback(response.data);
                    } else {
                        errorCallback && errorCallback(response.message);
                    }
                }).fail(function () {
                    errorCallback && errorCallback("Không thể kết nối đến máy chủ.");
                });
            }

            // Lấy danh sách tỉnh thành
            loadData(`${apiBase}/1/0.htm`, function (dataTinh) {
                $.each(dataTinh, function (key, val) {
                    $("#tinh").append(`<option value="${val.id}">${val.full_name}</option>`);
                });

                // Khi người dùng chọn tỉnh
                $("#tinh").change(function () {
                    const idTinh = $(this).val();
                    $("#quan").html('<option value="0">Quận huyện</option>');
                    $("#phuong").html('<option value="0">Phường xã</option>');

                    if (idTinh !== "0") {
                        // Lấy danh sách quận huyện
                        loadData(`${apiBase}/2/${idTinh}.htm`, function (dataQuan) {
                            $.each(dataQuan, function (key, val) {
                                $("#quan").append(`<option value="${val.id}">${val.full_name}</option>`);
                            });

                            // Khi người dùng chọn quận
                            $("#quan").change(function () {
                                const idQuan = $(this).val();
                                $("#phuong").html('<option value="0">Phường xã</option>');

                                if (idQuan !== "0") {
                                    // Lấy danh sách phường xã
                                    loadData(`${apiBase}/3/${idQuan}.htm`, function (dataPhuong) {
                                        $.each(dataPhuong, function (key, val) {
                                            $("#phuong").append(`<option value="${val.id}">${val.full_name}</option>`);
                                        });
                                    }, function (error) {
                                        alert(error);
                                    });
                                }
                            });
                        }, function (error) {
                            alert(error);
                        });
                    }
                });
            }, function (error) {
                alert(error);
            });
        });
    </script>

 
}
